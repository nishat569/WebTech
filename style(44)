body{
    font-family: Arial, sans-serif;
    background:#f2f2f2;
}

.container{
    width:500px;
    margin:30px auto;
    background:white;
    padding:20px;
    border-radius:8px;
    box-shadow:0 0 10px gray;
}

label{
    display:block;
    margin-top:10px;
    font-weight:bold;
}

input,
select,
textarea{
    width:100%;
    padding:8px;
    margin-top:5px;
}

input[type="radio"],
input[type="checkbox"]{
    width:auto;
}

button{
    width:100%;
    padding:10px;
    background:green;
    color:white;
    border:none;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:darkgreen;
}

.error{
    color:red;
    font-size:13px;
}

#successMessage{
    color:green;
    text-align:center;
}